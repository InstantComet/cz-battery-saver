[Unit]
Description=Battery Saver: CardputerZero power saving, deep idle with the screen off, low-battery shutdown
# Don't order after multi-user.target: a stuck boot job (e.g. userconfig.service
# waiting on tty8) would keep this service from ever starting.
After=systemd-user-sessions.service

[Service]
Type=simple
# Not root: the launcher, PipeWire and the keyboard belong to the desktop user,
# and the stock image's polkit rules let that user power off.
# By uid, not name: first-boot setup renames the default user "pi" but keeps
# uid/gid 1000.
User=1000
Group=1000
# /var/lib/cz-battery-saver, owned by that user: the app's settings and the USB flag
StateDirectory=cz-battery-saver
StateDirectoryMode=0755
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStart=/usr/bin/python3 /usr/lib/cz-battery-saver/cz-battery-saver.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
