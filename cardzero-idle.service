[Unit]
Description=CardputerZero deep idle when the screen is off, low-battery shutdown
# Don't order after multi-user.target: a stuck boot job (e.g. userconfig.service
# waiting on tty8) would keep this service from ever starting.
After=systemd-user-sessions.service

[Service]
Type=simple
EnvironmentFile=-/etc/default/cardzero-idle
ExecStart=/usr/bin/python3 /usr/local/sbin/cardzero-idle.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
